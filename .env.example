# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# MongoDB 접속 주소. 인증을 켠 경우:
#   mongodb://memo_app:<비밀번호>@127.0.0.1:27017/memo?authSource=memo
MONGO_URI=mongodb://localhost:27017
DB_NAME=memo

# 개발 서버 설정
HOST=127.0.0.1
PORT=5000

# 1 은 로컬 개발 전용입니다. 서버에서는 반드시 0 으로 두세요.
# 디버그 모드는 스택 트레이스와 대화형 콘솔을 노출합니다.
FLASK_DEBUG=0

LOG_LEVEL=INFO

# 서버에서는 production 으로 둡니다. SITE_ORIGIN 이나 레이트 리밋 저장소가
# 비어 있으면 기동을 거부해 설정 누락을 조용히 넘기지 않습니다.
APP_ENV=development

# 배포 스크립트가 커밋 해시를 넣습니다. /healthz 가 이 값을 알립니다.
APP_REVISION=unknown

# 소유자 정보가 없는 예전 메모를 고칠 때 쓰는 토큰. 비우면 그런 메모는 잠깁니다.
ADMIN_TOKEN=

# 사이트 자체 출처. 교차 사이트 쓰기 요청을 막는 데 씁니다.
# 비워 두면 검사하지 않습니다 (로컬 개발).
SITE_ORIGIN=

# 레이트 리밋
RATELIMIT_ENABLED=1
RATELIMIT_DEFAULT=120 per minute
RATELIMIT_WRITE=20 per minute
